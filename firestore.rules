rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper function to verify user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 2. Connection validation test document (allows getDocFromServer verification)
    match /test/{docId} {
      allow read: if true;
    }

    // 3. User profile document and all user-scoped isolated subcollections:
    // users/{userId}
    // users/{userId}/automations/{docId}
    // users/{userId}/contacts/{docId}
    // users/{userId}/inbox_messages/{docId}
    // users/{userId}/webhook_logs/{docId}
    // users/{userId}/instagram_account/{docId}
    // users/{userId}/gemini_api_keys/{docId}
    // users/{userId}/** (any recursive path under this user)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }
  }
}

